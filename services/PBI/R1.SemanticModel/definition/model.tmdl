model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

/// PostgreSQL host running the Odoo database. When Power BI Desktop runs in a
/// Windows VM, replace localhost with the Linux host address reachable by the VM.
expression OdooServer = "localhost" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Host port published by the local Odoo PostgreSQL container.
expression OdooPort = "5433" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Odoo PostgreSQL database name.
expression OdooDatabase = "fmcg_erp" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table 'Odoo Database Objects'

ref cultureInfo en-US

