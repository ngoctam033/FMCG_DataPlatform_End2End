# Copy this file to .env for local development.
# Add only non-secret examples here. Never commit real credentials.

APP_ENV=local
LOG_LEVEL=INFO

# Odoo ERP simulator
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=replace-with-a-local-database-password
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=replace-with-a-local-admin-password
ODOO_DB_LANGUAGE=vi_VN
ODOO_DB_COUNTRY=VN
ODOO_HTTP_PORT=8069
